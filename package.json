{
  "name": "kairos-studio",
  "version": "0.0.0",
  "private": true,
  "description": "A local studio for videos made with Claude Code: live preview, frame notes Claude can see, render queue, timeline editing and exports, with a pixel-art UI.",
  "license": "MIT",
  "author": "zehmbot",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n hub,web -c cyan,magenta \"npm:dev:hub\" \"npm:dev:web\"",
    "dev:hub": "node --watch src/server/index.ts --dev",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "favicon": "node scripts/favicon.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@tanstack/react-query": "^5.108.0",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
